# =============================================================================
# SULLIVAN Server Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================================

# =============================================================================
# CORE SETTINGS (Used across multiple services)
# =============================================================================
TZ=America/Toronto
PUID=1000
PGID=100
LIBVA_DRIVER_NAME=iHD

# =============================================================================
# MEDIA PATHS (Mount points for media libraries)
# =============================================================================
MEDIA_PATH=/mnt/media
MEDIA_PATH_MOVIES=/mnt/media/movies
MEDIA_PATH_SHOWS=/mnt/media/shows
MEDIA_PATH_MUSIC=/mnt/media/music
MEDIA_PATH_MUSIC_VIDEOS=/mnt/media/music_videos
MEDIA_PATH_BOOKS=/mnt/media/books
MEDIA_PATH_AUDIOBOOKS=/mnt/media/books/audiobooks
MEDIA_PATH_EBOOKS=/mnt/media/books/ebooks
MEDIA_PATH_EDU=/mnt/media/edu
MEDIA_PATH_SEED=/mnt/media/seed
MEDIA_PATH_CLEAN=/mnt/media/clean

# =============================================================================
# DOWNLOAD PATHS
# =============================================================================
DOWNLOAD_PATH_COMPLETE=/mnt/media/qbittorrent/complete
DOWNLOAD_PATH_INCOMPLETE=/media/qbittorrent/incomplete
DOWNLOAD_PATH_TORRENT=/media/qbittorrent/torrent
DOWNLOAD_PATH_MONITOR=/media/qbittorrent/monitor

# =============================================================================
# YOUTUBE PATHS
# =============================================================================
YOUTUBE_AUDIO_PATH=/mnt/media/youtube/audio
YOUTUBE_VIDEO_PATH=/mnt/media/youtube/video

# =============================================================================
# API KEYS (Copy from each service's Settings -> General -> API Key after startup)
# =============================================================================
SONARR_API_KEY=your_sonarr_api_key
RADARR_API_KEY=your_radarr_api_key
LIDARR_API_KEY=your_lidarr_api_key
PROWLARR_API_KEY=your_prowlarr_api_key

# =============================================================================
# FILEBOT SETTINGS
# =============================================================================
FILEBOT_USER=admin
FILEBOT_PASSWORD=changeme

# =============================================================================
# SEERR SETTINGS
# =============================================================================
# No additional env vars needed - configure via web UI at :5055

# =============================================================================
# TDARR SETTINGS
# =============================================================================
# GPU transcoding enabled by default via NVIDIA runtime
# Configure transcode settings via web UI at :8265

# =============================================================================
# RECYCLARR SETTINGS
# =============================================================================
# On first run, edit /config/recyclarr.yml inside the container
# to configure Sonarr/Radarr connections and TRaSH Guide profiles

# =============================================================================
# DATABASE PASSWORDS
# =============================================================================
WIKI_DB_USER=wikijs
WIKI_DB_NAME=wiki
WIKI_DB_PASSWORD=changeme_secure_password
MEALIE_DB_PASSWORD=changeme_secure_password

# =============================================================================
# DUPLICATI SETTINGS
# =============================================================================
DUPLICATI_ENCRYPTION_KEY=changeme_encryption_key
BACKUP_DESTINATION=/mnt/media/backup
BACKUP_SOURCE=/home/jordan/

# Address the management UIs of Prowlarr and qBittorrent bind to. Defaults to
# Sullivan's Tailscale address so those two are reachable over the tailnet but
# NOT from the house LAN — Prowlarr holds the private-tracker credential.
# Set to 0.0.0.0 to go back to publishing them on every interface.
# (The BitTorrent listen port 60000 is deliberately NOT covered by this.)
TAILNET_BIND=100.87.125.19
